CREATE TABLE job (
    id TEXT NOT NULL PRIMARY KEY,
    snapshot TEXT NOT NULL,
    state TEXT NOT NULL,
    revision INTEGER NOT NULL DEFAULT 0,
    next_sequence INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    hidden INTEGER NOT NULL DEFAULT 0
);
CREATE TABLE item (
    id TEXT NOT NULL PRIMARY KEY,
    job_id TEXT NOT NULL REFERENCES job(id),
    ordinal INTEGER NOT NULL,
    plan TEXT NOT NULL,
    state TEXT NOT NULL,
    revision INTEGER NOT NULL DEFAULT 0,
    lease_owner TEXT,
    lease_epoch INTEGER NOT NULL DEFAULT 0,
    attempt_sequence INTEGER NOT NULL DEFAULT 0,
    active_attempt TEXT,
    UNIQUE(job_id, ordinal)
);
CREATE TABLE attempt (
    id TEXT NOT NULL PRIMARY KEY,
    item_id TEXT NOT NULL REFERENCES item(id),
    sequence INTEGER NOT NULL,
    state TEXT NOT NULL,
    started_at INTEGER NOT NULL,
    ended_at INTEGER,
    stop_requested INTEGER NOT NULL DEFAULT 0,
    workspace TEXT,
    validation TEXT,
    output TEXT,
    diagnostic TEXT,
    UNIQUE(item_id, sequence)
);
CREATE TABLE event (
    job_id TEXT NOT NULL REFERENCES job(id),
    sequence INTEGER NOT NULL,
    item_id TEXT,
    type TEXT NOT NULL,
    payload TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    PRIMARY KEY(job_id, sequence)
);
CREATE TABLE reservation (
    target TEXT NOT NULL PRIMARY KEY,
    item_id TEXT NOT NULL UNIQUE REFERENCES item(id)
);
CREATE INDEX item_ready ON item(job_id, state, ordinal);
CREATE INDEX attempt_item ON attempt(item_id, sequence);
CREATE UNIQUE INDEX one_active_attempt ON attempt(item_id) WHERE state IN ('RUNNING','VALIDATED','PUBLISHING','PUBLISHED');

insertJob:
INSERT INTO job(id,snapshot,state,created_at) VALUES(?,?,?,?);
findJob:
SELECT * FROM job WHERE id = ?;
listJobs:
SELECT * FROM job WHERE hidden = 0 ORDER BY created_at DESC, id;
updateJob:
UPDATE job SET state = ?, revision = revision + 1 WHERE id = ?;
hideJob:
UPDATE job SET hidden = 1, revision = revision + 1 WHERE id = ?;
bumpSequence:
UPDATE job SET next_sequence = next_sequence + 1 WHERE id = ?;
insertEvent:
INSERT INTO event(job_id,sequence,item_id,type,payload,created_at) VALUES(?,?,?,?,?,?);
listEvents:
SELECT * FROM event WHERE job_id = ? ORDER BY sequence;
insertItem:
INSERT INTO item(id,job_id,ordinal,plan,state) VALUES(?,?,?,?,?);
findItem:
SELECT * FROM item WHERE id = ?;
listItems:
SELECT * FROM item WHERE job_id = ? ORDER BY ordinal;
allItems:
SELECT * FROM item ORDER BY job_id, ordinal;
nextReady:
SELECT * FROM item WHERE job_id = ? AND state IN ('READY','INTERRUPTED') ORDER BY ordinal LIMIT 1;
claimItem:
UPDATE item SET state = 'RUNNING', revision = revision + 1, lease_owner = ?, lease_epoch = lease_epoch + 1,
    attempt_sequence = attempt_sequence + 1, active_attempt = ? WHERE id = ?;
setItemState:
UPDATE item SET state = ?, revision = revision + 1, lease_owner = NULL WHERE id = ?;
insertAttempt:
INSERT INTO attempt(id,item_id,sequence,state,started_at) VALUES(?,?,?,'RUNNING',?);
findAttempt:
SELECT * FROM attempt WHERE id = ?;
latestAttempt:
SELECT * FROM attempt WHERE item_id = ? ORDER BY sequence DESC LIMIT 1;
listAttempts:
SELECT * FROM attempt WHERE item_id = ? ORDER BY sequence;
setWorkspace:
UPDATE attempt SET workspace = ? WHERE id = ?;
setValidation:
UPDATE attempt SET validation = ?, state = 'VALIDATED' WHERE id = ?;
setPublishing:
UPDATE attempt SET state = 'PUBLISHING' WHERE id = ?;
setPublished:
UPDATE attempt SET state = 'PUBLISHED', output = ? WHERE id = ?;
stopAttempt:
UPDATE attempt SET stop_requested = 1 WHERE id = ?;
endAttempt:
UPDATE attempt SET state = ?, ended_at = ?, diagnostic = ? WHERE id = ?;
reserveTarget:
INSERT INTO reservation(target,item_id) VALUES(?,?);
releaseTarget:
DELETE FROM reservation WHERE item_id = ?;
findReservation:
SELECT item_id FROM reservation WHERE target = ?;
