CREATE TABLE job_item (
    id INTEGER NOT NULL PRIMARY KEY,
    state TEXT NOT NULL,
    revision INTEGER NOT NULL DEFAULT 0,
    attempt_count INTEGER NOT NULL DEFAULT 0
);
insertItem:
INSERT INTO job_item(id, state) VALUES (?, ?);
allItems:
SELECT * FROM job_item ORDER BY id;
updateState:
UPDATE job_item SET state = ?, revision = revision + 1 WHERE id = ? AND revision = ?;
